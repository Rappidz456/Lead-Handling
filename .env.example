# ─── Required ────────────────────────────────────────────────────────────────

# MongoDB Atlas or local. ${VAR} references are expanded, e.g.
#   DBPASSWORD=secret
#   MONGODB_URI=mongodb+srv://user:${DBPASSWORD}@cluster0.xxxx.mongodb.net/
# (URL-encode the password if it contains @ : / ? # %)
MONGODB_URI=

# https://console.groq.com/keys
GROQ_API_KEY=

# Single admin account for the protected endpoint (password: min 8 chars)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Min 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── Optional (defaults shown) ───────────────────────────────────────────────

PORT=3000
JWT_EXPIRES_IN=8h
MONGODB_DB_NAME=leads

# Business context the LLM replies on behalf of. Example:
#   BUSINESS_NAME="Brightline Merch Co."
#   BUSINESS_DESCRIPTION="We make custom branded merchandise (hoodies, mugs, ...). Minimum order 25 units. Production 7-10 business days."
BUSINESS_NAME=our company
BUSINESS_DESCRIPTION=

# LLM tuning
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# HTTP
# Reverse-proxy hops to trust for client IPs: 0 locally, 1 behind Render/Railway/Nginx
TRUST_PROXY=0
BODY_LIMIT=20kb
# Comma-separated browser origins allowed to call the API, or * for any. Empty = no CORS.
CORS_ORIGINS=

# Rate limits
SUBMIT_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
